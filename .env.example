# Copy to .env (git ignores it) and fill in, then run: npm run dev
PORT=3024
# Google sign-in: create an OAuth "Web application" client in Google Cloud Console
# and add http://localhost:3024 (and your live domain) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Real SMS for OTP. Leave blank to stay in demo mode (code is shown on screen).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# NODE_ENV=production   # turns on Secure cookies; use behind HTTPS
# Code for claiming the very first admin account on the editor page (/admin). Only works while no admin exists.
ADMIN_SETUP_CODE=
