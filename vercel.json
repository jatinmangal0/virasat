{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "node scripts/migrate.js",
  "outputDirectory": "server/public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__p=:path*" }
  ]
}
