{
  "name": "virasat",
  "private": true,
  "type": "module",
  "description": "Virasat: learn the heritage of Indian cities with Gaju the elephant. Website + API + Postgres database, hosted on Vercel with the database on Neon.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
