    "migrate": "node --env-file-if-exists=.env scripts/migrate.js"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.1",
    "express": "^4.21.0"
  }
}
